{
  "request": {
    "method": "POST",
    "urlPathPattern": "/possystem/v4/.*/report/.*",
    "headers": {
      "Content-Type": {
        "matches": "application/json.*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "delayDistribution": {
      "type": "uniform",
      "lower": 150,
      "upper": 2500
    },
    "jsonBody": {
      "uuid": "{{randomValue type='UUID'}}",
      "timestamp": "{{now}}",
      "error": null,
      "status": "done"
    }
  }
}